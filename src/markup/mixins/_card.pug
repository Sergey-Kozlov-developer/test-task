
mixin card(image, badge, title, price, speaker)
    -
        // Простая мапа цветов
        const colors = {
            "Marketing": "#03CEA4",
            "Design": "#F52F6E",
            "Management": "#5A87FC",
            "HR & Recruiting": "#F89828",
            "Development": "#7772F1"
            //- "All": "#787a80"
        }

        const bgColor = colors[badge] || colors["HR & Recruiting"]
        const dataCategory = badge.toLowerCase()
    
    .card(data-category=dataCategory)
        img.card__image(src=image, alt=title loading="lazy")
        .card__content 
            button.card__button(
                style=`background: ${bgColor}; color: ${textColor}`
                type="button"
                aria-label=`Category: ${badge}`
            )
                span.card__badge= badge
            p.card__title= title
            .card__info 
                span.card__price= `$${price}`
                span.card__speaker= `| by ${speaker}`
